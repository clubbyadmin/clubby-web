# Copie para .env.local e ajuste. O .env.local real nunca vai para o git.

# URL pública da API (demo: https://api-demo.seudominio | prod: https://api.seudominio)
NEXT_PUBLIC_API_URL=http://localhost:3000

# demo | production — "demo" mostra a faixa amarela e os atalhos de login
NEXT_PUBLIC_APP_MODE=production
